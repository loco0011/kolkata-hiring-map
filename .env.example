# Settings for docker compose. Copy to .env and fill in every blank.
# App-specific settings live in web/.env and fetcher/.env (see DEPLOY.md).

# Your domain, e.g. hiringmap.in — Caddy gets an HTTPS certificate for it.
# Use :80 for plain HTTP (on your PC, or behind another proxy).
SITE_ADDRESS=:80
# The site's public URL (https://your-domain on the server)
APP_URL=http://localhost
# Host ports Caddy listens on
HTTP_PORT=80
HTTPS_PORT=443

# Database (created on first start). Generate passwords with:
#   openssl rand -base64 24
DB_DATABASE=kolkata_hiring_map
DB_USERNAME=khm
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Shared secret between the site and the fetcher. Generate with:
#   openssl rand -base64 32
INGEST_API_TOKEN=
