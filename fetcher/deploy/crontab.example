# Fetcher cron entries — add with `crontab -e` as the user that owns the app.
# Adjust APP to where the project lives. Run `mkdir -p $APP/fetcher/logs` once.
APP=/var/www/kolkata-hiring-map

# Laravel scheduler (already required by the site)
* * * * * cd $APP && php artisan schedule:run >> /dev/null 2>&1

# New jobs from ATS boards / careers pages → /dashboard pending submissions
30 2 * * * cd $APP/fetcher && .venv/bin/python manage.py fetch_jobs >> logs/fetch.log 2>&1

# Nightly link check — only with LINK_CHECKER=python in the Laravel .env
30 3 * * * cd $APP/fetcher && .venv/bin/python manage.py check_links >> logs/check.log 2>&1
