# Copy to fetcher/.env and fill in.

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=127.0.0.1,localhost
# Default is a SQLite file next to manage.py, which is plenty for this service.
# To use MySQL instead: mysql://user:password@127.0.0.1:3306/khm_fetcher
DATABASE_URL=

# --- The Laravel site ---
# Where the hiring map runs. On the same VPS this can be the public https URL.
LARAVEL_BASE_URL=https://your-domain.example
# Must match INGEST_API_TOKEN in the Laravel .env.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(40))"
INGEST_API_TOKEN=

# --- Fetching ---
# Seconds to wait between companies (fetch) and between links (check).
FETCH_DELAY_SECONDS=1.0
CHECK_DELAY_SECONDS=0.5
# Jobs with no location at all, or remote-only jobs, are skipped by default —
# the map is about who is hiring *in Kolkata*. Set to true to queue them anyway.
INCLUDE_UNKNOWN_LOCATION=false
INCLUDE_REMOTE=false
